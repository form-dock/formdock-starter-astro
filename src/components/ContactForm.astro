---
// The FormDock-wired contact form. No JavaScript, no backend — the form
// posts straight to your FormDock endpoint (set it in src/config.ts).
// Submissions are spam-filtered, stored, and emailed to your recipients.
import { FORMDOCK_ENDPOINT } from "../config";
---

<form class="contact-form" action={FORMDOCK_ENDPOINT} method="POST">
  <label>
    Name
    <input type="text" name="name" required autocomplete="name" placeholder="Jane Doe" />
  </label>
  <label>
    Email
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="jane@company.com"
    />
  </label>
  <label>
    Message
    <textarea
      name="message"
      rows="6"
      required
      placeholder="What are you building, and when does it need to exist?"></textarea>
  </label>

  <!-- Honeypot: bots fill this hidden field and get flagged as spam.
       Keep it hidden and empty — real visitors never see it. -->
  <input
    type="text"
    name="_gotcha"
    class="hp"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <button type="submit">Send message →</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
  }
  input,
  textarea {
    font: inherit;
    font-weight: 400;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--bg);
    color: var(--ink);
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 0.7;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .hp {
    display: none;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 0.85rem 1.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
    justify-self: start;
    transition: transform 120ms ease, filter 120ms ease;
  }
  button:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }
</style>
