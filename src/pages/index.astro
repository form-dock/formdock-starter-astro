---
import Base from "../layouts/Base.astro";
import { SITE_NAME, SITE_TAGLINE } from "../config";
---

<Base>
  <main>
    <section class="hero">
      <h1>{SITE_TAGLINE}</h1>
      <p>
        This is a one-page starter for a freelancer or small studio: fast,
        accessible, zero JavaScript — with a working contact form powered by
        FormDock. Replace this copy with your own story.
      </p>
      <a class="button" href="/contact">Start a project →</a>
    </section>

    <section id="work" class="cards">
      <h2>Selected work</h2>
      <div class="grid">
        <article>
          <h3>Project one</h3>
          <p>A sentence about the outcome you delivered — not the tools.</p>
        </article>
        <article>
          <h3>Project two</h3>
          <p>What changed for the client after you shipped it.</p>
        </article>
        <article>
          <h3>Project three</h3>
          <p>Keep these short; link out to case studies if you have them.</p>
        </article>
      </div>
    </section>

    <section id="services" class="cards">
      <h2>Services</h2>
      <div class="grid">
        <article>
          <h3>Design</h3>
          <p>Branding, sites, product UI.</p>
        </article>
        <article>
          <h3>Development</h3>
          <p>Fast, maintainable builds on modern tooling.</p>
        </article>
        <article>
          <h3>Ongoing care</h3>
          <p>Updates, monitoring, and a human who answers.</p>
        </article>
      </div>
    </section>

    <section class="closer">
      <h2>Have a project in mind?</h2>
      <p>Tell us about it — we reply within one business day.</p>
      <a class="button" href="/contact">Get in touch</a>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
    max-width: 38rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .hero p {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 1.75rem;
  }
  .button {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
    padding: 0.7rem 1.2rem;
    border-radius: 0.5rem;
  }
  .cards {
    padding: 2rem 0;
  }
  .cards h2,
  .closer h2 {
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .grid article {
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.1rem 1.25rem;
    background: var(--panel);
  }
  .grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
  }
  .grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .closer {
    text-align: center;
    padding: 3.5rem 0 1rem;
  }
  .closer p {
    color: var(--muted);
    margin: 0.25rem 0 1.5rem;
  }
</style>
