---
import { SITE_NAME, SITE_TAGLINE } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_NAME, description = SITE_TAGLINE } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">{SITE_NAME}</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#services">Services</a>
        <a href="/contact" class="cta">Start a project</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {SITE_NAME}</span>
      <span class="powered">
        Forms by <a href="https://formdock.app">FormDock</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf8f4;
    --ink: #1f1b16;
    --muted: #756c61;
    --line: #e8e2d8;
    --panel: #ffffff;
    --panel-soft: #f3efe8;
    --accent: #b4530a;
    --accent-soft: #f6e3d3;
    --accent-ink: #fdf9f4;
    --shadow: 0 1px 2px rgb(31 27 22 / 0.04), 0 12px 32px -16px rgb(31 27 22 / 0.18);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161311;
      --ink: #f0eae1;
      --muted: #9c9287;
      --line: #2d2823;
      --panel: #1d1916;
      --panel-soft: #221d19;
      --accent: #e98a4b;
      --accent-soft: #33241a;
      --accent-ink: #1c120a;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 12px 32px -16px rgb(0 0 0 / 0.55);
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.65;
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2,
  h3,
  .brand,
  blockquote {
    font-family: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino,
      Georgia, serif;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  a {
    color: inherit;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 64rem;
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }
  .brand {
    font-size: 1.15rem;
    text-decoration: none;
  }
  .site-header nav {
    display: flex;
    gap: 1.35rem;
    align-items: center;
    font-size: 0.95rem;
  }
  .site-header nav a {
    text-decoration: none;
    color: var(--muted);
    transition: color 120ms ease;
  }
  .site-header nav a:hover {
    color: var(--ink);
  }
  .site-header nav a.cta {
    color: var(--accent-ink);
    background: var(--accent);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 600;
    transition: transform 120ms ease, filter 120ms ease;
  }
  .site-header nav a.cta:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    padding: 1.75rem 1.5rem;
    max-width: 64rem;
    width: 100%;
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .site-footer a {
    color: var(--muted);
  }

  /* CSS-only scroll reveal — progressive enhancement, motion-safe */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: rise-in both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
      @keyframes rise-in {
        from {
          opacity: 0;
          transform: translateY(1.25rem);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>
